    <!-- http://benchmark/OWL2Bench#WomanCollege -->


    <owl:Class rdf:about="http://benchmark/OWL2Bench#WomanCollege">
        <rdfs:subClassOf rdf:resource="http://benchmark/OWL2Bench#College"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://benchmark/OWL2Bench#College"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://benchmark/OWL2Bench#hasStudent"/>
                        <owl:allValuesFrom>
                            <owl:Class>
                                <owl:complementOf rdf:resource="http://benchmark/OWL2Bench#Man"/>
                            </owl:Class>
                        </owl:allValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


