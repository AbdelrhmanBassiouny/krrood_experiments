<?xml version="1.0"?>
<rdf:RDF xmlns="http://benchmark/OWL2Bench#"
     xml:base="http://benchmark/OWL2Bench"
     xmlns:obda="https://w3id.org/obda/vocabulary#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:benchmark-dl="http://semantics.crl.ibm.com/univ-bench-dl.owl#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:dc="http://purl.org/dc/elements/1.1/">
    <owl:Ontology rdf:about="http://benchmark/OWL2Bench"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://benchmark/OWL2Bench#dislikes -->


    <owl:ObjectProperty rdf:about="http://benchmark/OWL2Bench#dislikes">
        <rdfs:domain rdf:resource="http://benchmark/OWL2Bench#Person"/>
        <rdfs:range rdf:resource="http://benchmark/OWL2Bench#Interest"/>
        <owl:propertyDisjointWith rdf:resource="http://benchmark/OWL2Bench#likes"/>
    </owl:ObjectProperty>
    


    <!-- http://benchmark/OWL2Bench#enrollFor -->


    <owl:ObjectProperty rdf:about="http://benchmark/OWL2Bench#enrollFor">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://benchmark/OWL2Bench#Student"/>
        <rdfs:range rdf:resource="http://benchmark/OWL2Bench#Program"/>
    </owl:ObjectProperty>
    


    <!-- http://benchmark/OWL2Bench#enrollIn -->


    <owl:ObjectProperty rdf:about="http://benchmark/OWL2Bench#enrollIn">
        <rdfs:subPropertyOf rdf:resource="http://benchmark/OWL2Bench#isStudentOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://benchmark/OWL2Bench#Student"/>
        <rdfs:range rdf:resource="http://benchmark/OWL2Bench#Department"/>
    </owl:ObjectProperty>
    


    <!-- http://benchmark/OWL2Bench#evaluatedBy -->


    <owl:ObjectProperty rdf:about="http://benchmark/OWL2Bench#evaluatedBy">
        <owl:inverseOf rdf:resource="http://benchmark/OWL2Bench#evaluates"/>
